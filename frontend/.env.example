# Copy this file to .env in frontend/. Both values below are also the
# built-in defaults if you don't set them.

# Person 1's LLM/incident-extraction API (resqmesh_llm_workflow_integrated)
VITE_PERSON1_API_URL=http://localhost:8001

# Person 2's real-data dispatch API (resqmesh_backend / person2_backend)
VITE_PERSON2_API_URL=http://localhost:8000
